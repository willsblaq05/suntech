# Local environment and secrets
.env
.env.*
!.env.example
backend/.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
backend/.venv/
backend/*.db
backend/*.sqlite3

# Node
node_modules/
frontend/**/node_modules/
frontend/**/dist/

# npm workspaces must keep a single lockfile (at frontend/). A nested
# workspace lockfile causes npm to prune cross-platform optional
# dependencies (rolldown/oxide bindings) when the root lock regenerates,
# which breaks production builds (native binding not found).
frontend/suntech_projects/package-lock.json

# Local generated lockfile outside the frontend workspace
/package-lock.json

# Uploaded media (testimonial photos) — lives on the server volume
backend/media/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
