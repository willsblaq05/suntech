# Environment variables for SUNTECH PROJECTS
# Copy this file to .env and fill in your actual values.

# Database (PostgreSQL connection string)
POSTGRES_URL=postgresql+psycopg://user:password@localhost:5432/suntech_db

# Application
DEBUG=True
API_V1_STR=/api/v1

# Security
# SECRET_KEY: generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-or-base64-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Single-operator admin account for the back office (list/update/delete leads).
# Leave ADMIN_PASSWORD empty to keep the back office locked.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Rate limiting — public lead form submissions allowed per IP per minute.
RATE_LIMIT_LEAD_CREATE_PER_MINUTE=10

# CORS — origins the website is served from, e.g. Vite dev server.
# BACKEND_CORS_ORIGINS=["http://localhost:5173"]
